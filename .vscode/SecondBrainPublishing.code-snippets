	"post": {
		"prefix": "np",
		"body": [
			"---",
			"author: ${2:Enter Author}",
			"tags: [${3:no-tag}]",
			"status: ${4|draft,review,ready|}",
			"channels: ${5|blog,ebook,pdf|}",
			"uuid: $UUID",
			"created: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
			"updated: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
			"project: ${4:Enter Project}",
			"id: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE$CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND",
